{
  "name": "webstar-reels",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Automated daily reel pipeline: website URL -> 1080x1920 reel -> Instagram + TikTok",
  "scripts": {
    "reel": "tsx src/pipeline.ts",
    "reel:dry": "tsx src/pipeline.ts --dry-run",
    "reel:mock": "tsx src/pipeline.ts --dry-run --mock",
    "studio": "remotion studio remotion/index.ts",
    "buffer:channels": "tsx src/steps/post.ts --list-channels",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@remotion/bundler": "^4.0.542",
    "@remotion/cli": "^4.0.542",
    "@remotion/fonts": "^4.0.542",
    "@remotion/renderer": "^4.0.542",
    "dotenv": "^18.0.10",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.542",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
