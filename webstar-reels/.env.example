# --- Shared by every brand ---
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Buffer API key: https://publish.buffer.com/settings/api
BUFFER_ACCESS_TOKEN=

# --- Per brand: the suffix is the brand id from brands/<id>.json, in capitals ---

# ElevenLabs voice for each brand (needed for every run, including --dry-run).
ELEVENLABS_VOICE_ID_WEBSTAR=
ELEVENLABS_VOICE_ID_VIA77=

# Buffer channel IDs each brand posts to, comma-separated (not needed with --dry-run).
# Run `npm run buffer:channels` to list them. Keeping the service prefix skips a lookup:
#   BUFFER_PROFILE_IDS_WEBSTAR=instagram:abc123,tiktok:def456
BUFFER_PROFILE_IDS_WEBSTAR=
BUFFER_PROFILE_IDS_VIA77=

# --- Optional ---
# If a brand's channels live in a different Buffer account, give it its own key:
# BUFFER_ACCESS_TOKEN_VIA77=
# CLAUDE_MODEL=claude-opus-5-5
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Public URL of a brand's rendered MP4, if you host it yourself (Buffer downloads the video
# from a URL). In GitHub Actions this is handled automatically with a GitHub Release.
# VIDEO_PUBLIC_URL_WEBSTAR=
# Use a specific Chrome/Chromium binary for recording and rendering.
# CHROMIUM_PATH=
