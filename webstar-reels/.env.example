# --- Required for every run (including --dry-run) ---
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Required to post (not needed with --dry-run) ---
# Buffer API key: https://publish.buffer.com/settings/api
BUFFER_ACCESS_TOKEN=
# Comma-separated Buffer channel IDs for your Instagram + TikTok channels.
# Run `npm run buffer:channels` to list them. Optional service prefix skips the lookup:
#   BUFFER_PROFILE_IDS=instagram:abc123,tiktok:def456
BUFFER_PROFILE_IDS=

# --- Optional ---
# CLAUDE_MODEL=claude-opus-5-5
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# POST_TIME=18:00
# POST_TIMEZONE=Australia/Melbourne
# Public URL of the rendered MP4, if you host it yourself (Buffer downloads the video from a URL).
# In GitHub Actions this is set automatically from a GitHub Release.
# VIDEO_PUBLIC_URL=
# Use a specific Chrome/Chromium binary for recording and rendering.
# CHROMIUM_PATH=
