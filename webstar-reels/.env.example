# ===== Claude: runs on your Claude subscription through Claude Code =====
# Scripts, captions, site copy and briefs are written by `claude -p` (Claude Code headless), using
# the account you're logged into in Claude Code. Install it and log in once:
#   npm install -g @anthropic-ai/claude-code   then run `claude` and type /login
# LLM=claude-code is the default. Set LLM=api (and ANTHROPIC_API_KEY) to use the API instead.
# LLM=claude-code
# Optional: a specific model for Claude Code (otherwise your plan's default).
# CLAUDE_CODE_MODEL=
# Leave this empty for subscription use. If it's set, it's ignored for Claude Code calls anyway.
ANTHROPIC_API_KEY=

# ===== Shared by every brand =====
# ElevenLabs: voiceovers with word timings.
ELEVENLABS_API_KEY=
# Buffer API key (publish.buffer.com → Settings → API): schedules to Instagram, TikTok and YouTube.
BUFFER_ACCESS_TOKEN=
# Approved reels are uploaded to a GitHub Release in this public repo so Buffer can download them.
# Log the gh CLI in once with `gh auth login`.
GITHUB_REPOSITORY=owner/webstar-reels
# OpenAI API key (platform.openai.com/api-keys): photoreal images for generated sites.
# Without it, generated sites use placeholder images and the review page says so.
OPENAI_API_KEY=
# Which image provider `npm run make` uses: openai (default) or nano-banana (Google Gemini; needs GEMINI_API_KEY).
IMAGE_PROVIDER=openai
# GEMINI_API_KEY=
# Vercel token (vercel.com/account/tokens): preview deployments for generated sites.
VERCEL_TOKEN=
# VERCEL_TEAM_ID=

# fal.ai key (fal.ai/dashboard/keys): Verrano AI visualisation reels. Billed by fal per clip.
# Without it, no AI reels are made and those days use real footage instead.
FAL_KEY=
# Which preset in ai.json to use: kling, veo3 or runway (or one you add).
# FAL_VIDEO_MODEL=kling
# Preset in ai.json for generated laptop-zoom intro clips (npm run intros:generate): veo3 or kling.
# FAL_INTRO_MODEL=veo3

# ===== Per brand: the suffix is the brand id in capitals =====
ELEVENLABS_VOICE_ID_WEBSTAR=
ELEVENLABS_VOICE_ID_VIA77=
ELEVENLABS_VOICE_ID_VERRANO=
# Buffer channel IDs each brand posts to: its Instagram, TikTok and YouTube channels.
# `npm run buffer:channels` lists them. e.g. instagram:abc123,tiktok:def456,youtube:ghi789
BUFFER_PROFILE_IDS_WEBSTAR=
BUFFER_PROFILE_IDS_VIA77=
BUFFER_PROFILE_IDS_VERRANO=
# A brand whose channels are in another Buffer account:
# BUFFER_ACCESS_TOKEN_VERRANO=

# ===== Lead tracking (docs/lead-tracking.md) =====
# Supabase project holding the reels and lead_events tables. The service key stays on this Mac.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Your deployed "go" function. Gives every reel a short link that counts clicks.
# TRACK_BASE_URL=https://<ref>.supabase.co/functions/v1/go

# ===== Notifications =====
# Mac notifications are always on. These add copies elsewhere (optional):
# Email through Resend
# RESEND_API_KEY=
# NOTIFY_EMAIL=you@example.com
# NOTIFY_FROM=Reels <reels@yourdomain.com>
# Phone push through the ntfy app (pick a long, private topic name)
# NTFY_TOPIC=

# ===== Approval page =====
# REVIEW_PORT=4777
# Minutes before the day's first slot when undecided reels stop waiting and don't post.
# REVIEW_LEAD_MINUTES=30

# ===== References =====
# Where reference folders live. Default: ./references, which setup-mac.sh links to iCloud Drive.
# REFERENCES_DIR=

# ===== Optional =====
# Turn Verrano stills into short clips with your fal/Wan script. {input} {output} {prompt} are filled in.
# ANIMATE_STILL_CMD=python3 ~/scripts/wan.py --image {input} --out {output} --prompt {prompt}
# VERCEL_PROJECT_VIA77=via77-concepts
# OpenAI image model. Left unset, the newest gpt-image model your key can use is tried first.
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_QUALITY=high
# Used when IMAGE_PROVIDER=nano-banana:
# IMAGE_MODEL=gemini-3.1-flash-image
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# CLAUDE_BIN=claude
# CHROMIUM_PATH=
