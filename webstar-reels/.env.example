# ===== Shared by every brand =====

# Claude: writes the sites and the reel scripts.
ANTHROPIC_API_KEY=
# ElevenLabs: voiceovers with word timings.
ELEVENLABS_API_KEY=
# Buffer API key (publish.buffer.com → Settings → API): schedules to Instagram, TikTok and YouTube.
BUFFER_ACCESS_TOKEN=
# Google Gemini API key (aistudio.google.com): Nano Banana 2 images for generated sites.
# Without it, generated sites use placeholder images and the review says so.
GEMINI_API_KEY=
# Vercel token (vercel.com/account/tokens): preview deployments for generated sites.
# Without it, sites are built and recorded locally but get no preview link.
VERCEL_TOKEN=
# Only if the token belongs to a team:
# VERCEL_TEAM_ID=

# ===== Approval notifications (optional; GitHub review issues work without these) =====
# Resend API key and where to send review emails.
# RESEND_API_KEY=
# NOTIFY_EMAIL=you@example.com
# NOTIFY_FROM=Reels <reels@yourdomain.com>

# ===== Per brand: the suffix is the brand id in capitals =====

ELEVENLABS_VOICE_ID_WEBSTAR=
ELEVENLABS_VOICE_ID_VIA77=

# Buffer channel IDs each brand posts to: its Instagram, TikTok and YouTube channels.
# Run `npm run buffer:channels` to list them. Keeping the service prefix skips a lookup:
#   BUFFER_PROFILE_IDS_WEBSTAR=instagram:abc123,tiktok:def456,youtube:ghi789
BUFFER_PROFILE_IDS_WEBSTAR=
BUFFER_PROFILE_IDS_VIA77=

# ===== Optional =====
# A brand whose channels live in another Buffer account:
# BUFFER_ACCESS_TOKEN_VIA77=
# Vercel project per brand (default: <brand>-concepts):
# VERCEL_PROJECT_VIA77=via77-concepts
# CLAUDE_MODEL=claude-opus-5-5
# IMAGE_MODEL=gemini-3.1-flash-image
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Running locally against your GitHub repo (videos are hosted as release files, reviews as issues):
# GITHUB_REPOSITORY=owner/webstar-reels
# GH_TOKEN=
# Use a specific Chrome/Chromium binary for recording, auditing and rendering.
# CHROMIUM_PATH=
